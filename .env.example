# ─── proteus gateway — many agents, one process ───────────────────────────────
# Client auth — callers send: Authorization: Bearer <API_KEY>
# Empty = open mode (no auth). Dev only.
API_KEY=change-me
# SECOND key, required on top of API_KEY (header: X-Proteus-Admin-Key) before an
# HTTP caller may use the host-access tools: shell, run_code, email, schedule.
# LEAVE EMPTY unless you truly need them over HTTP — API_KEY is typically shared
# with every product surface that talks to the gateway, so if it alone unlocked
# `shell`, anyone who obtained it would have remote code execution on this host.
# Allowlisted channel users (TELEGRAM_ALLOWED_USERS) get these tools regardless.
ADMIN_API_KEY=

# Server bind. proteus binds all interfaces by default — put it behind a reverse
# proxy, or set HOST=127.0.0.1, rather than relying on a cloud firewall alone.
HOST=0.0.0.0
PORT=18791
WORKERS=4

# ─── Model (provider-neutral via LiteLLM) ────────────────────────────────────
# Switch providers by changing MODEL + supplying the matching key below:
#   anthropic/claude-sonnet-4-6   ·  openai/gpt-4o-mini
#   openrouter/anthropic/claude-3.5-sonnet  ·  groq/llama-3.3-70b  ·  ollama/llama3.1
#   xai/grok-3-mini               ·  moonshot/kimi-latest      ·  deepseek/deepseek-chat
#   codex/gpt-5.5                 (ChatGPT subscription via OAuth — see below)
#   kimi-code/kimi-for-coding     (Moonshot's coding endpoint; own host + key)
#   mock/fast                     (synthetic, for load tests — see README)
# `proteus auth login` authenticates whichever one MODEL names.
MODEL=anthropic/claude-sonnet-4-6
MAX_TOKENS=1500
MAX_TOOL_TURNS=8
TEMPERATURE=0.3
# Hard ceiling on ONE upstream completion. Generous on purpose (a reasoning model
# can legitimately run minutes); its job is to stop a stalled connection holding
# a stream and a concurrency slot forever.
REQUEST_TIMEOUT=300
LLM_RETRIES=2

# ─── Backpressure ────────────────────────────────────────────────────────────
# Upstream completions in flight PER WORKER, so the real cap is this x WORKERS.
# Over the cap, a request waits CONCURRENCY_WAIT seconds for a slot, then gets
# 503 + Retry-After. Without a cap a traffic spike becomes provider 429s for
# EVERYONE including users already mid-answer; with one it becomes "some users
# wait", which clients can retry through. 0 disables it.
# Tune from /healthz `concurrency`: sustained in_use near limit = add workers;
# a climbing `rejected` = you needed to already.
MAX_CONCURRENT_COMPLETIONS=64
CONCURRENCY_WAIT=20
# Tool calls within ONE turn run concurrently up to this many. Models emit
# several per turn, and running them in sequence costs the SUM of the tools
# instead of the slowest one.
MAX_PARALLEL_TOOLS=8

# ─── Streaming & prompt caching ──────────────────────────────────────────────
# Batch SSE deltas into one frame for this many ms. 0 = a frame per token
# (smoothest). ~25 cuts streaming CPU noticeably under load; the FIRST token is
# never buffered, so time-to-first-token is unaffected either way.
STREAM_COALESCE_MS=0
# Send an explicit cache breakpoint to providers that need one (Anthropic).
# OpenAI / Codex / Gemini cache a stable prefix automatically and ignore this.
# The system prompt is assembled stable-first with the clock last precisely so
# that prefix stays byte-identical between turns.
PROMPT_CACHING=true

# Provider keys — set whichever matches MODEL (LiteLLM reads these from env).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=            # Kimi via the Moonshot platform
# MOONSHOT_API_BASE=https://api.moonshot.cn/v1   # China platform; .ai is the default

# Kimi Code (MODEL=kimi-code/…). OpenAI-compatible but a different host and key,
# so it is NOT `openai/…` — pointing OPENAI_API_BASE at it would hijack every
# real OpenAI model too.
KIMI_CODE_API_KEY=
KIMI_CODE_API_BASE=https://api.kimi.com/coding/v1

# ─── ChatGPT subscription backend (only when MODEL=codex/…) ──────────────────
# Run `bash scripts/codex_login.sh` once to create proteus's own token chain.
# auto = proteus's own file, then other local tools' auth files (READ-ONLY: proteus
# never refreshes a chain it doesn't own, since refresh tokens are single-use).
CODEX_AUTH_SOURCE=auto        # auto | own | hermes | codex
CODEX_REASONING_EFFORT=medium # low | medium | high | "" to disable reasoning

# ─── Postgres (OPTIONAL) ─────────────────────────────────────────────────────
# Only memory, channels and scheduled jobs need it — /v1/chat/completions is
# stateless. Unset or unreachable, proteus boots degraded (chat still works) and
# reconnects on its own. Needs the pgvector extension for memory. Use a POOLED
# endpoint if you have one (proteus sets statement_cache_size=0, PgBouncer's rule).
# Leave EMPTY for a pure chat gateway. TLS is skipped for localhost and for
# sslmode=disable, so a plain local Postgres works with no extra flags.
DATABASE_URL=
# Managed:  postgresql://user:pass@host/db?sslmode=require
# Local:    postgresql://user:pass@127.0.0.1:5432/proteus
DB_POOL_MIN=2
DB_POOL_MAX=20

# ─── Embeddings (Ollama, 1024-dim mxbai-embed-large) ─────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=mxbai-embed-large

# ─── Agent identity & tools ──────────────────────────────────────────────────
# Fallback persona used only when there is no agents/ directory (relative to app/).
SYSTEM_PROMPT_FILE=prompts/assistant.md
# Comma list: none | basics | web | agent | custom   (e.g. TOOLSET=basics,web)
#   basics = datetime_now, calculate, remember, recall, todo  (no host access)
#   web    = web_search, web_fetch, browser                   (no host access)
#   agent  = web + run_code, shell, email, schedule           (each gated below)
#   custom = your own tools/*.md and app/tools/custom/*.py
# Only a fallback: with an agents/ directory, each agent names its own toolset.
TOOLSET=none
# Where read_file / list_files may look. Colon-separated for several roots.
#   empty  -> both tools refuse (default)
#   /a:/b  -> confined to those roots; reaches nothing sensitive, so any agent
#             may have them
#   /      -> the WHOLE filesystem, for a personal assistant whose user is the
#             operator. Unconfined reads are shell-equivalent (.env, ~/.ssh,
#             token files), so in this mode the tools become HOST tools and are
#             withheld from anyone not explicitly trusted.
FILES_ROOT=
FILES_MAX_BYTES=1000000
# SSRF guard for any tool given a model-chosen URL. Cloud metadata endpoints
# stay blocked even when this is true. See app/tools/url_safety.py.
ALLOW_PRIVATE_URLS=false
# Profile used when a request names none (header X-Proteus-Profile / body.profile).
DEFAULT_PROFILE=assistant

# ─── Tool gates ──────────────────────────────────────────────────────────────
# Search providers, tried in order. With NONE set, web_search drives the real
# browser instead (TOOLS_BROWSER=true), because scraping search engines over
# plain HTTP now gets a challenge page rather than results.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
SEARCH_URL_TEMPLATE=https://www.bing.com/search?q=
WEB_FETCH_MAX_CHARS=6000
# Real headless Chromium, in-process via Playwright.
#   pip install 'proteus-gateway[browser]' && playwright install chromium
TOOLS_BROWSER=true
TOOLS_BROWSER_TIMEOUT=45
# Arbitrary Python on this host. Keep off unless the surface is trusted.
TOOLS_CODE_EXEC=false
TOOLS_CODE_TIMEOUT=12
# Arbitrary shell on this host — i.e. every CLI installed on the box.
TOOLS_SHELL=false
TOOLS_SHELL_TIMEOUT=30
# Reads/sends mail via the himalaya CLI using its configured accounts.
TOOLS_EMAIL=false
TOOLS_EMAIL_TIMEOUT=30
HIMALAYA_BIN=/usr/local/bin/himalaya

# ─── Memory (Postgres + pgvector; channels and scheduled jobs) ───────────────
MEMORY_ENABLED=true
MEMORY_RECENT_MESSAGES=12    # working-memory window
MEMORY_RECALL_K=5            # long-term memories injected per turn
MEMORY_RECALL_MIN_SCORE=0.25
MEMORY_DISTILL_EVERY=3       # curate every N user turns
MEMORY_DISTILL_WINDOW=14
MEMORY_DEDUP_SIM=0.92
MEMORY_MAX_PER_USER=40
MEMORY_CURATOR_MODEL=        # empty = inherit MODEL
MEMORY_CURATOR_EFFORT=low    # reasoning models only; keeps curation quick
MEMORY_VISION_CAPTION=true   # caption inbound images so they persist as text

# ─── Scheduled tasks ─────────────────────────────────────────────────────────
# Any process may CREATE jobs; exactly one must RUN them. With channels that is
# the channels_runner process. An HTTP-only deployment has no such process, so
# set CRON_IN_WEB=true (and WORKERS=1, or every worker fires the same job).
CRON_ENABLED=true
CRON_IN_WEB=false
# Cap on enabled jobs per user. Each one is a model call on a timer, so an
# unbounded list is a way to spend your provider quota.
MAX_JOBS_PER_USER=20
CRON_TZ=UTC                  # cron expressions are interpreted in this timezone
CRON_CHECK_INTERVAL=30

# ─── Channels ────────────────────────────────────────────────────────────────
RUN_CHANNELS_IN_WEB=false    # true only with WORKERS=1 (dev); else use proteus-channels
PUBLIC_BASE_URL=             # https origin for webhook registration (Telegram/WhatsApp)

# Telegram (@BotFather token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling        # polling | webhook
# csv of numeric sender ids. Also the trust boundary for host tools: an open bot
# (empty allowlist) never gets shell/run_code/email/schedule.
TELEGRAM_ALLOWED_USERS=

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=         # enables X-Hub-Signature-256 verification
WHATSAPP_GRAPH_VERSION=v21.0

# Signal (signal-cli-rest-api)
SIGNAL_CLI_REST_URL=         # e.g. http://127.0.0.1:8080
SIGNAL_NUMBER=               # registered bot number, e.g. +15551234567
SIGNAL_POLL_INTERVAL=3

# ─── Optional: Redis ─────────────────────────────────────────────────────────
# Needed for cross-replica inbound dedup. If set, every tool event is also
# XADD'd to the stream below for audit/analytics — live UI visibility does NOT
# require Redis, since events stream inline over SSE.
REDIS_URL=
TOOL_EVENT_STREAM=proteus:tool-events
