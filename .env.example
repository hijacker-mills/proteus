# ─── acag gateway ──────────────────────────────────────────────────────────
# Client auth — callers send: Authorization: Bearer <API_KEY>
API_KEY=change-me

# Server bind
HOST=0.0.0.0
PORT=18791
WORKERS=4

# ─── Model (provider-neutral via LiteLLM) ────────────────────────────────────
# Switch providers by changing MODEL + supplying the matching key below:
#   anthropic/claude-sonnet-4-6   ·  openai/gpt-4o-mini
#   openrouter/anthropic/claude-3.5-sonnet  ·  groq/llama-3.3-70b  ·  ollama/llama3.1
MODEL=anthropic/claude-sonnet-4-6
MAX_TOKENS=1500
MAX_TOOL_TURNS=8
TEMPERATURE=0.3

# Provider keys — set whichever matches MODEL (LiteLLM reads these from env).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ─── Postgres (Neon POOLED endpoint — note the -pooler host) ─────────────────
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require
DB_POOL_MIN=2
DB_POOL_MAX=20

# ─── Embeddings (Ollama, 1024-dim mxbai-embed-large) ─────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=mxbai-embed-large

# ─── IntelliQ app (proxy tools target) ───────────────────────────────────────
INTELLIQ_APP_URL=http://127.0.0.1:3001
QUBI_INTERNAL_SECRET=

# ─── Agent identity & tools ──────────────────────────────────────────────────
# System prompt file (relative to app/). Default = general assistant.
# Set to "qubi_soul.md" + TOOLSET=intelliq to run the IntelliQ study agent.
SYSTEM_PROMPT_FILE=prompts/assistant.md
TOOLSET=none                 # none | intelliq

# ─── Channel sessions (per-sender memory) ────────────────────────────────────
# Redis strongly recommended once channels are enabled (shared across the web
# replicas + poller process). In-memory fallback is single-process/dev only.
SESSION_MAX_MESSAGES=20
SESSION_TTL_SECONDS=86400
RUN_CHANNELS_IN_WEB=false    # true only with WORKERS=1 (dev); else use acag-channels
PUBLIC_BASE_URL=             # https origin for webhook registration (Telegram/WhatsApp)

# ─── Channel: Telegram (@BotFather token) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling        # polling | webhook
TELEGRAM_ALLOWED_USERS=      # optional csv of numeric ids / usernames

# ─── Channel: WhatsApp (Meta Cloud API) ──────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=         # enables X-Hub-Signature-256 verification
WHATSAPP_GRAPH_VERSION=v21.0

# ─── Channel: Signal (signal-cli-rest-api) ───────────────────────────────────
SIGNAL_CLI_REST_URL=         # e.g. http://127.0.0.1:8080
SIGNAL_NUMBER=               # registered bot number, e.g. +15551234567
SIGNAL_POLL_INTERVAL=3

# ─── Optional integrations ───────────────────────────────────────────────────
IMAGE_SEARCH_SERVICE_URL=
IMAGE_SEARCH_SERVICE_TOKEN=
# If set, every tool event is XADD'd to this Redis stream (analytics/audit).
# Live UI visibility does NOT require Redis — events also stream inline over SSE.
REDIS_URL=
TOOL_EVENT_STREAM=acag:tool-events
